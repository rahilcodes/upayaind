# ─── Core (required everywhere) ───
DATABASE_URL="postgresql://postgres@localhost:5432/upayaind"
AUTH_SECRET=""                 # openssl rand -base64 48
NEXT_PUBLIC_APP_URL="http://localhost:3000"
VAULT_MASTER_KEY=""            # openssl rand -base64 32  (32 bytes, base64)

# ─── Google sign-in for students (optional) ───
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Cloudflare R2 (required in production; local disk in dev) ───
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ─── Anthropic (resume AI) ───
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_MODEL_FAST=""

# ─── Stripe ───
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Razorpay (P1, India) ───
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Email (Resend). In dev, emails print to the console. ───
RESEND_API_KEY=""
EMAIL_FROM="UpayaInd <hello@upayaind.com>"

# ─── Inngest (background jobs) ───
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Upstash Redis (rate limits; in-memory in dev) ───
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── WhatsApp notifications via Twilio (optional; students opt in under /app/settings) ───
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""        # e.g. whatsapp:+14155238886

# ─── Observability & analytics ───
SENTRY_DSN=""                  # server + edge; without a DSN Sentry is a no-op
NEXT_PUBLIC_SENTRY_DSN=""      # browser
SENTRY_ORG=""                  # source-map upload at build time (CI only, needs all three)
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
LOG_LEVEL=""                   # debug | info | warn | error (default: debug in dev, warn in tests)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
CALCOM_LINK=""
