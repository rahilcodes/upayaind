{
  "name": "upayaind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate:offline": "node --no-warnings scripts/migrate-wasm.mjs create",
    "db:deploy:offline": "node --no-warnings scripts/migrate-wasm.mjs deploy",
    "postinstall": "prisma generate"
  },
